  "authors": [
    "theone_ss", "spusik_", "PinkGoosik", "DoctorNight1"
  ],
  "contributors": [
    "Jom3a-J"
  ],
  "contact": {
    "homepage": "https://github.com/Jom3a-J/EatingAnimationUpdatedFork",
    "sources": "https://github.com/Jom3a-J/EatingAnimationUpdatedFork",
    "issues": "https://github.com/Jom3a-J/EatingAnimationUpdatedFork/issues"
  },

