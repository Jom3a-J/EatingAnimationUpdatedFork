{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": {
      "type": "minecraft:model",
      "model": "foodplusid:item/glow_berries_pie"
    },
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": "gui",
          "model": {
            "type": "minecraft:model",
            "model": "foodplusid:item/glow_berries_pie"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:range_dispatch",
        "property": "eatinganimationid:eat",
        "entries": [
          {
            "threshold": 0.35,
            "model": {
              "type": "minecraft:model",
              "model": "foodplusid:item/glow_berries_pie_eating_0"
            }
          },
          {
            "threshold": 0.7,
            "model": {
              "type": "minecraft:model",
              "model": "foodplusid:item/glow_berries_pie_eating_1"
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "minecraft:model",
              "model": "foodplusid:item/glow_berries_pie_eating_2"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "foodplusid:item/glow_berries_pie"
        }
      }
    }
  }
}
